{
  "manifest_version": 3,
  "name": "Meesho AI Listing Tool V2",
  "description": "Premium AI assisted listing tool for Meesho Supplier Panel.",
  "version": "2.0.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://supplier.meesho.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zen Lister V2"
  },
  "content_scripts": [
    {
      "matches": ["https://supplier.meesho.com/*"],
      "css": ["styles.css"],
      "js": [
        "ui.js",
        "detector.js",
        "analyzer.js",
        "filler.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
